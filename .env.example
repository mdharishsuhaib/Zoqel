# ─── Zoqel Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=zoqel
DB_PASSWORD=zoqel_secret

# 🤖 LLM Provider (Ollama Cloud)
# Enter your Ollama Cloud API key here
OPENROUTER_API_KEY=your-ollama-cloud-key-here

# 🔗 LLM Endpoint URL
LLM_BASE_URL=https://api.ollama.cloud/v1

# Model to use
OPENROUTER_MODEL=gpt-oss:120b-cloud
