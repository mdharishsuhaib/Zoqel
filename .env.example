# ─── Zoqel Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=zoqel
DB_PASSWORD=zoqel_secret

# 🤖 LLM Provider
# Get your API key for your chosen provider.
OPENROUTER_API_KEY=your-api-key-here

# 🔗 LLM Endpoint URL
# Default is the Alibaba Cloud compatible-mode endpoint, but you can override it here.
# Option 1 (Default): https://ws-jt98l2xmgqt6pb7l.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Option 2 (Anthropic): https://ws-jt98l2xmgqt6pb7l.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
LLM_BASE_URL=https://ws-jt98l2xmgqt6pb7l.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Model to use (default: openai/gpt-4o or your provider's specific model string)
OPENROUTER_MODEL=openai/gpt-4o
